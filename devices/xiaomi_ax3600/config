#
# Xiaomi AX3600 (IPQ8071A, 512 MB) — the reference build.
#
# Concatenated onto devices/common/config by prepare-build.sh.
#

CONFIG_TARGET_qualcommax_ipq807x_DEVICE_xiaomi_ax3600=y

# 512 MB board: the ath11k profile is also forced by kmod-ath11k's NSS block,
# and the NSS MEDIUM profile replaces the ipq807x default (HIGH), which does
# not fit here.
CONFIG_ATH11K_MEM_PROFILE_512M=y
CONFIG_NSS_MEM_PROFILE_MEDIUM=y

CONFIG_ATH10K-CT_LEDS=n
CONFIG_PACKAGE_ath10k-board-qca9887=n
CONFIG_PACKAGE_ath10k-firmware-qca9887=n
CONFIG_PACKAGE_ath10k-firmware-qca9887-ct=n
CONFIG_PACKAGE_kmod-ath10k-ct-smallbuffers=n

## Hardware this board does not have.
CONFIG_PACKAGE_kmod-phy-aquantia=n
CONFIG_PACKAGE_kmod-usb-core=n
CONFIG_PACKAGE_kmod-usb-dwc3=n
CONFIG_PACKAGE_kmod-usb-dwc3-qcom=n
CONFIG_PACKAGE_kmod-usb-xhci-hcd=n
CONFIG_PACKAGE_kmod-usb3=n


## My Packages and Utilities
CONFIG_PACKAGE_luci-proto-wireguard=y

CONFIG_PACKAGE_luci-app-ddns=y
CONFIG_PACKAGE_ddns-scripts-cloudflare=y

# mDNS/Bonjour: UDP 5353, para Google Cast/Chromecast y otros servicios.
CONFIG_PACKAGE_avahi-dbus-daemon=y
CONFIG_PACKAGE_avahi-utils=y

# SSDP/UPnP: UDP 1900, usado por HEOS/Marantz para descubrir dispositivos.
CONFIG_PACKAGE_smcroute=y
